# Shared development settings
NODE_ENV=development

# Application ports published to the host
WEB_PORT=3000
API_PORT=4000

# API runtime configuration
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000

# Local PostgreSQL credentials and host port
POSTGRES_USER=clientflow
POSTGRES_PASSWORD=clientflow
POSTGRES_DB=clientflow
POSTGRES_PORT=5432

# Host processes connect through the published PostgreSQL port.
# Docker Compose supplies the "postgres" service hostname to containers automatically.
DATABASE_URL=postgresql://clientflow:clientflow@localhost:5432/clientflow
