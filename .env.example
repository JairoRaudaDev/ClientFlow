# Shared development settings
NODE_ENV=development

# Application ports published to the host
WEB_PORT=3000
API_PORT=4000

# API runtime configuration
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000

# Local PostgreSQL credentials and host port
POSTGRES_USER=clientflow
POSTGRES_PASSWORD=clientflow
POSTGRES_DB=clientflow
POSTGRES_PORT=5432

# "postgres" is the database hostname inside Docker.
# An application running directly on the host would normally use "localhost" instead.
DATABASE_URL=postgresql://clientflow:clientflow@postgres:5432/clientflow
