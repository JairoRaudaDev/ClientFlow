{"nodes": [{"id": "_interface_design_system_system", "label": "Interface Design System Document", "file_type": "document", "source_file": ".interface-design/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_interface_design_system_design_system", "label": "ClientFlow Design System", "file_type": "concept", "source_file": ".interface-design/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source of truth for shared product UI (interface-design scope: dashboards, client screens, settings). Direction is a calm, focused workbench for freelancers and small service businesses: legible, dense-but-clean, with a single indigo accent - explicitly not a glass/blue SaaS dashboard and not a marketing site. Marketing-only patterns live in a separate marketing.md file."}, {"id": "_interface_design_system_palette", "label": "Design Palette", "file_type": "concept", "source_file": ".interface-design/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_interface_design_system_indigo_accent", "label": "Indigo Accent", "file_type": "concept", "source_file": ".interface-design/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slate neutrals with one indigo accent (#4f46e5) chosen so the product reads quiet, airy, and predictable and does not resemble a generic glass/blue SaaS dashboard. Semantic status colors (emerald for success, red for destructive/errors) are used sparingly."}, {"id": "_interface_design_system_type", "label": "Typography", "file_type": "concept", "source_file": ".interface-design/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_interface_design_system_appshell", "label": "AppShell Layout", "file_type": "rationale", "source_file": ".interface-design/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_interface_design_system_container", "label": "Container Layout", "file_type": "rationale", "source_file": ".interface-design/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_interface_design_system_data_states", "label": "Data View States", "file_type": "rationale", "source_file": ".interface-design/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every data view must have a loading state (role=status), a retryable error state (role=alert), an empty state, and a no-results state so all states are accessible and predictable."}, {"id": "_interface_design_system_forms", "label": "Form Validation Pattern", "file_type": "rationale", "source_file": ".interface-design/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_interface_design_system_confirmation_dialog", "label": "Confirmation Dialog", "file_type": "rationale", "source_file": ".interface-design/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_interface_design_system_responsive_tables", "label": "Responsive Tables", "file_type": "rationale", "source_file": ".interface-design/system.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Desktop client list renders as a table hidden below md; mobile renders stacked cards. Both are rendered so only one is in the accessibility tree at a time."}], "edges": [{"source": "_interface_design_system_design_system", "target": "_interface_design_system_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score":