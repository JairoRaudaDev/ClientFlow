{"nodes": [{"id": "api_readme_clientflow_api", "label": "ClientFlow API README", "file_type": "document", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_readme_authentication", "label": "API Authentication", "file_type": "rationale", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_readme_access_token", "label": "JWT Access Token", "file_type": "rationale", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Short-lived HS256 access tokens only; no refresh tokens or server-side revocation yet, so logout means removing the token client-side. Claims include sub, iss, aud, iat, exp, jti, tokenType=access and carry no email/workspace/role data. Rate limiting, account lockout, email verification, password reset, and MFA are intentionally deferred."}, {"id": "api_readme_register", "label": "POST /auth/register", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_readme_login", "label": "POST /auth/login", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_readme_current_user", "label": "GET /auth/me", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_readme_client_management", "label": "Client Management", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any current workspace member can manage clients; granular role permissions are intentionally not part of the MVP. Cross-workspace lookups return the same CLIENT_NOT_FOUND so the API never reveals whether another workspace owns an ID. Client data is never logged."}, {"id": "api_readme_workspace_header", "label": "X-Workspace-Id Header", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_readme_structured_search", "label": "QUERY /clients/search", "file_type": "rationale", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QUERY is a read-only, idempotent alternative for structured filters (hasEmail, hasPhone); it does not replace GET /clients. POST, PUT, PATCH, and DELETE never invoke the structured search handler."}, {"id": "api_readme_pagination", "label": "Pagination", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_readme_health", "label": "GET /health", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_readme_scrypt_passwords", "label": "scrypt Password Hashing", "file_type": "rationale", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_readme_user", "label": "User Entity", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "api_readme_workspace", "label": "Workspace Entity", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null