{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@clientflow/api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_HOST",
        "API_PORT",
        "CORS_ORIGIN",
        "DATABASE_URL",
        "JWT_ACCESS_TOKEN_TTL",
        "JWT_AUDIENCE",
        "JWT_ISSUER",
        "JWT_SECRET",
        "NODE_ENV"
      ]
    },
    "@clientflow/web#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOST", "NODE_ENV", "NEXT_PUBLIC_API_URL", "WEB_PORT"]
    },
    "build": {
      "dependsOn": ["^build"]
    },
    "@clientflow/types#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@clientflow/api#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@clientflow/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "clean": {
      "dependsOn": ["^clean"],
      "cache": false
    }
  }
}
