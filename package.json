{
  "name": "clientflow",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @clientflow/api db:generate",
    "db:validate": "pnpm --filter @clientflow/api db:validate",
    "db:format": "pnpm --filter @clientflow/api db:format",
    "db:migrate": "pnpm --filter @clientflow/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @clientflow/api db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @clientflow/api db:migrate:status",
    "db:seed": "pnpm --filter @clientflow/api db:seed",
    "db:studio": "pnpm --filter @clientflow/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
